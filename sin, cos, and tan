import math
def sine(o, h):
    sintheta = o / h
    print(f"Sine of angle with opposite side {o} and hypotenuse {h} is: {sintheta}")
sine(5, 13)

def cosine(a, h):
    costheta = a / h
    print(f"Cosine of angle with adjacent side {a} and hypotenuse {h} is: {costheta}")
sine(12, 13)

def tangent(o, a):
    tantheta = o / a
    print(f"Tangent of angle with opposite side {o} and adjacent side {a} is: {tantheta}")
sine(5, 12)
