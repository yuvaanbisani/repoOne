#word matching
def matchwords(words):
    ctr = 0
    list = []
    for word in words:
        if len(word) > 1 and word[0] == word[-1]:
            ctr += 1
            list.append(word)
    print("number of words matching criteria:", ctr)
ctr = matchwords(['abc', 'xyz', 'aba', '420024', "1221", "adam", "madam", "python andna nohtyp" ])
print(ctr)
