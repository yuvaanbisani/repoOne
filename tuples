#palindromic parlindrome
def palin(r):
    e = len(r) - 1
    s = 0
    while s < e:
        if r[s] != r[e]:
            return False
        s += 1
        e -= 1
    return True
r = ("stressed desserts")
palin(r)
if palin(r):
    print("palindrome")
else:
    print("not palindrome")
    
