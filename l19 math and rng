#number game
import random
playing = True
num = str(random.randint(1, 10))
print("i will generate a number from 1 to -1, and YOU have to guess the number at a time.")
print("the game ends when you get the right number.")
while playing:
    guess = input("Guess a number between 1 to n : ")
    if num == guess:
        print("You win the game!")
        print("The numner was : ", num)
        break
    else:
        print("Your guess is nt quite right, try again.")

